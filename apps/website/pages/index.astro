---
// Hallmark · genre: modern-minimal · macrostructure: Workbench · theme: Cobalt
// Single fold: both jobs, then one prompt a person pastes into a coding agent.
import PageLayout from "blume/components/layout/PageLayout.astro";
import CodeBlock from "blume/components/content/CodeBlock.astro";
import data from "blume:data";
import Footer from "./_home/Footer.astro";

const { config } = data;

/**
 * Full prompt copied to the clipboard. The page clips this block with CSS.
 * Steps end on a check. Pocket agents and inspect-traces stay behind links.
 */
const agentPrompt = `Assess the agent setup in this project and show what to fix. Ship the work that repeats.

1. Assess. Run dora scan. List the gaps. Run dora review --quick on the skill folder. No API key.
   Done when Findings are listed and the exit code is reported. Exit 0 is clean.
   When dora is missing from PATH, run npx skills add saif-shines/doraval, then npm install -g @hacksmith/doraval, and rerun this step.

2. Apply the safe fixes. Run dora fix skills --yes. Then run dora review --run.
   Done when both passes have run and the exit code is reported.

3. Ship the work that repeats as a pocket agent. One job, one machine, one user.
   Read Pocket agents at https://doraval.dev/get-started/pocket-agents/. Grill a small loop, test one pass, then apply it.
   Done when a Routine is watching, or nothing in this project repeats.

4. When asked to read a session on this computer: Run dora session open. Or open https://doraval.dev/inspect-traces/.
   Done when the session is on screen. The logs stay on this machine.`;
---

<PageLayout
  site={{ title: config.title, description: config.description }}
  logo={config.logo}
  favicon={config.favicon}
  banner={config.banner}
  analytics={config.analytics}
  navigation={data.navigation}
  fontCssVars={data.fontCssVars}
  themeMode={config.theme.mode}
  searchEnabled={config.search.enabled}
  siteUrl={config.site}
  ogEnabled={config.og.enabled}
  page={{
    title: `${config.title}: ${config.description}`,
    description: config.description,
    route: "/",
  }}
>
  <div class="home">
    <section class="hero">
      <div class="hero__copy reveal">
        <p class="home-eyebrow">FOR CODING AGENTS</p>
        <h1 class="hero__title">Assess the agent setup. Ship the work.</h1>
        <h2 class="hero__subtitle">Show what to fix. Share it, including a pocket agent.</h2>
        <nav class="paths" aria-label="Prompt to paste into your coding agent">
          <p class="paths__for">Paste into your coding agent.</p>
          <div class="paths__block">
            <CodeBlock code={agentPrompt} lang="txt" />
            <button class="paths__copy" type="button" data-copy={agentPrompt} aria-label="Copy the full prompt">Copy</button>
          </div>
        </nav>
        <nav class="home-cta" aria-label="Browse">
          <a href="/get-started/">Browse the docs</a>
          <a href="/get-started/pocket-agents/">Pocket agents</a>
          <a href="/inspect-traces/">Inspect traces</a>
        </nav>
      </div>
    </section>
  </div>

  <Footer slot="footer" />
</PageLayout>

<style>
  .home {
    --home-space-md: 1.25rem;
    --home-space-lg: 1.5rem;
    --home-space-xl: 2rem;
    --home-ease-out: cubic-bezier(0.16, 1, 0.3, 1);

    width: 100%;
    max-width: 46rem;
    margin-inline: auto;
    margin-block: auto;
    padding-inline: var(--home-space-md);
    padding-block: var(--home-space-xl);
  }

  /* Pin the thin footer to the window edge. Center the fold in the space above it. */
  :global(body:has(.home)) {
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
  }

  :global(body:has(.home) #blume-content) {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .home-eyebrow {
    margin: 0 0 0.75rem;
    font-family: var(--blume-font-mono);
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--blume-accent);
  }

  .hero {
    display: block;
  }

  .hero__title {
    font-family: var(--blume-font-display);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.05;
    font-size: clamp(2.25rem, 4.4vw + 0.9rem, 3.5rem);
    overflow-wrap: anywhere;
    min-width: 0;
    margin: 0 0 0.65rem;
  }

  .hero__subtitle {
    font-family: var(--blume-font-display);
    font-weight: 500;
    letter-spacing: -0.015em;
    line-height: 1.35;
    font-size: clamp(1.2rem, 1.6vw + 0.7rem, 1.5rem);
    margin: 0 0 0.9rem;
    color: var(--blume-muted-foreground);
    max-width: 40ch;
  }

  .hero :global(pre),
  .hero :global(code) {
    font-size: 0.95rem;
  }

  .paths {
    margin-top: 0.35rem;
  }

  .paths__for {
    margin: 0 0 0.55rem;
    color: var(--blume-muted-foreground);
    font-size: 0.92rem;
  }

  .paths__copy:focus-visible {
    outline: 2px solid var(--blume-accent);
    outline-offset: 2px;
  }

  .paths__block {
    position: relative;
    margin: 0;
  }

  .paths__block :global(.prose),
  .paths__block :global(pre) {
    margin: 0;
  }

  .paths__block :global(pre),
  .paths__block :global(code) {
    white-space: pre-wrap;
    overflow-wrap: break-word;
  }

  .paths__block :global(pre) {
    max-height: 10.5rem;
    overflow: hidden;
    padding-right: 4.75rem;
    mask-image: linear-gradient(to bottom, #000 58%, transparent);
    -webkit-mask-image: linear-gradient(to bottom, #000 58%, transparent);
  }

  .paths__copy {
    position: absolute;
    top: 0.45rem;
    right: 0.45rem;
    z-index: 1;
    border: 0;
    border-radius: var(--blume-radius);
    background: var(--blume-muted);
    padding: 0.28rem 0.55rem;
    font-family: var(--blume-font-mono);
    font-size: 0.75rem;
    line-height: 1;
    color: var(--blume-foreground);
    cursor: pointer;
    transition: transform 160ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .paths__copy:active {
    transform: scale(0.97);
  }

  .home-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .home-cta a {
    display: inline-flex;
    align-items: center;
    min-height: 2.25rem;
    padding: 0.35rem 0.75rem;
    border: 1px solid var(--blume-border);
    border-radius: var(--blume-radius);
    color: var(--blume-foreground);
    font-size: 0.92rem;
    text-decoration: none;
    transition: color 160ms cubic-bezier(0.23, 1, 0.32, 1), border-color 160ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .home-cta a:hover {
    color: var(--blume-accent);
    border-color: var(--blume-accent);
  }

  .home-cta a:focus-visible {
    outline: 2px solid var(--blume-accent);
    outline-offset: 2px;
  }

  .reveal {
    animation: home-reveal 600ms var(--home-ease-out) both;
  }

  @keyframes home-reveal {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal {
      animation: none;
    }

    .paths__copy,
    .home-cta a {
      transition: none;
    }

    .paths__copy:active {
      transform: none;
    }
  }

</style>

<script>
  const timers = new WeakMap();
  for (const button of document.querySelectorAll(".paths__copy")) {
    if (!(button instanceof HTMLButtonElement)) continue;
    button.addEventListener("click", () => {
      const text = (button.dataset.copy ?? "").replace(/\n+$/u, "");
      const pending = timers.get(button);
      if (pending) clearTimeout(pending);
      const show = (label: string) => {
        button.textContent = label;
        timers.set(
          button,
          setTimeout(() => {
            button.textContent = "Copy";
          }, 1200),
        );
      };
      if (!text) {
        show("Copy failed");
        return;
      }
      navigator.clipboard.writeText(text).then(
        () => show("Copied"),
        () => show("Copy failed"),
      );
    });
  }
</script>
