---
import PageLayout from "blume/components/layout/PageLayout.astro";
import data from "blume:data";
import Sessions from "../islands/Sessions.tsx";

const { config } = data;
---

<PageLayout
  site={{ title: config.title, description: config.description }}
  logo={config.logo}
  favicon={config.favicon}
  banner={config.banner}
  analytics={config.analytics}
  navigation={data.navigation}
  fontCssVars={data.fontCssVars}
  themeMode={config.theme.mode}
  searchEnabled={config.search.enabled}
  siteUrl={config.site}
  ogEnabled={config.og.enabled}
  page={{
    title: "Inspect traces",
    description: "Read Claude, Grok, Cursor, Codex, Copilot, and Gemini CLI sessions from a folder on this computer. Two example traces are shown until you choose a folder. Nothing is uploaded.",
    route: "/inspect-traces",
  }}
>
  <Sessions client:only="react" />
</PageLayout>
